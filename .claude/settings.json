{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(bun run build)",
      "Bash(bun run check:format)",
      "Bash(bun run check:lint)",
      "Bash(bun run fmt)",
      "Bash(bun run test)",
      "Bash(bun run typecheck)",
      "Bash(gh pr create *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git switch *)"
    ],
    "deny": ["Edit(.git/**)"]
  }
}
