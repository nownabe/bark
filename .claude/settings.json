{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git push *)",
      "Bash(git switch *)"
    ],
    "deny": ["Edit(.git/**)"]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git", "gh"],
    "network": {
      "allowedDomains": ["registry.npmjs.org"]
    },
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": ["."],
      "denyWrite": [".git"]
    }
  }
}
