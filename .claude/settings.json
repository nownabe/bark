{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Edit(.git/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git",
      "gh"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "."
      ],
      "denyWrite": [
        ".git"
      ]
    }
  }
}
