{
  "name": "bark",
  "version": "0.5.0",
  "private": true,
  "description": "Google Docs-like Markdown review for GitHub Pull Requests (Chrome MV3 extension)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "preview": "vite --config dev/preview/vite.config.ts",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "wxt build && playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.local/playwright-browsers playwright install chromium",
    "fmt": "oxfmt --write",
    "postinstall": "wxt prepare",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@uiw/react-codemirror": "^4.25.10",
    "diff-match-patch": "^1.0.5",
    "mermaid": "^11.15.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/diff-match-patch": "^1.0.36",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.1.0",
    "happy-dom": "^20.10.4",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.70.0",
    "typescript": "^7.0.0",
    "wxt": "^0.20.0"
  },
  "overrides": {
    "@vitejs/plugin-react": "^4.3.4",
    "publish-browser-extension": "^4.0.5"
  }
}
